            "subject": "CS301",
            "exam": "mst2",
            "question": "What is the worst-case time complexity of QuickSort?",
            "optionA": "O(n)",
            "optionB": "O(n log n)",
            "optionC": "O(n^2)",
            "optionD": "O(log n)",
            "answer": "C"
        },
